BASE_URL=https://parabank.parasoft.com/parabank

HEADLESS=true
BROWSER=chromium

PW_TIMEOUT_MS=10000
PW_NAVIGATION_TIMEOUT_MS=15000
REQUEST_TIMEOUT_SECONDS=30

BACKEND_TRANSPORT=proxy
BROWSER_TRANSPORT=direct

BLOCK_NONESSENTIAL_RESOURCES=true
UI_SCENARIO_DELAY_SECONDS=2.0

# Workaround temporário para o ambiente público:
# clientes recém-cadastrados autenticam, mas a consulta
# de contas pode retornar HTTP 500. Cenários que dependem
# de contas usam um cliente público já existente.
PUBLIC_EXISTING_USERNAME=john
PUBLIC_EXISTING_PASSWORD=demo

SCRAPE_DO_TOKEN=

SCRAPE_DO_API_URL=https://api.scrape.do/
SCRAPE_DO_PROXY_URL=http://proxy.scrape.do:8080
SCRAPE_DO_BROWSER_PROXY_PARAMS=render=false
